# BigWigs packager config (https://github.com/BigWigsMods/packager), used by .github/workflows/release.yml.
#
# The addon lives in the EasyGather/ subfolder of this repo. move-folders lifts its contents up to the top of the
# package, so the zip contains EasyGather/EasyGather.toc and players can drop the folder straight into Interface\AddOns.
package-as: EasyGather
enable-nolib-creation: no

move-folders:
  EasyGather/EasyGather: EasyGather

ignore:
  - README.md
  - .pkgmeta
  - .gitignore
  - .github
  - branding
  - curseforge
